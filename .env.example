# Copy to .env.local for local dev, and set these as Vercel Environment
# Variables for the deployed project. Do not commit real secrets.

# Shared secret Shopify shows when you create the products webhook. Used to
# verify the X-Shopify-Hmac-Sha256 signature on /api/shopify-webhook.
SHOPIFY_WEBHOOK_SECRET=

# Vapi private API key. Only needed for administrative tasks (registering the
# lookup_product tool / updating the assistant). The runtime endpoints do NOT
# read this. Stored as an env var per project convention.
VAPI_PRIVATE_KEY=

# Optional. If set, /api/refresh-catalog requires Authorization: Bearer <value>.
# Vercel Cron sends this automatically when CRON_SECRET is configured.
CRON_SECRET=

# Optional overrides (sensible defaults are baked in).
# PRODUCTS_JSON_URL=https://kymralighting.co.uk/products.json
# CATALOG_TTL_MS=3600000
# CURRENCY_SYMBOL=£
